# ─────────────────────────────────────────────
# DATABASE (Connection Pooling for Vercel)
# ─────────────────────────────────────────────
POSTGRES_USER=nalogai
POSTGRES_PASSWORD=
POSTGRES_DB=nalogai
# Pooled connection string — used by Prisma Client at runtime
# For Neon: postgresql://user:pass@host/db?pgbouncer=true
# For Prisma Accelerate: prisma://accelerate.prisma-data.net/?api_key=...
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nalogai
# Direct connection — used ONLY by prisma migrate deploy (no pooling)
DATABASE_URL_DIRECT=postgresql://postgres:postgres@localhost:5432/nalogai

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_URL=redis://:PASSWORD@localhost:6379

# ─────────────────────────────────────────────
# JWT SECRETS
# ─────────────────────────────────────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ─────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=

# ─────────────────────────────────────────────
# RELIABILITY
# ─────────────────────────────────────────────
GROQ_BREAKER_TIMEOUT_MS=20000
GROQ_BREAKER_RESET_MS=30000
GROQ_BREAKER_ERROR_THRESHOLD=50
GROQ_BREAKER_VOLUME_THRESHOLD=3
EGOV_BREAKER_SUBMIT_TIMEOUT_MS=35000
EGOV_BREAKER_STATUS_TIMEOUT_MS=20000
EGOV_BREAKER_RESET_MS=30000
EGOV_BREAKER_ERROR_THRESHOLD=50
EGOV_BREAKER_VOLUME_THRESHOLD=3
NOTIFICATION_WORKER_CONCURRENCY=5

# ─────────────────────────────────────────────
# AI — PROVIDER SELECTION
# Set to "gemini" or "groq"
# ─────────────────────────────────────────────
AI_PROVIDER=groq

# ─────────────────────────────────────────────
# AI — GOOGLE GEMINI
# ─────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ─────────────────────────────────────────────
# AI — GROQ (Llama)
# ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ─────────────────────────────────────────────
# NOTIFICATIONS
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@nalogai.kz

# ─────────────────────────────────────────────
# PAYMENT GATEWAY — CloudPayments
# https://cloudpayments.kz
# ─────────────────────────────────────────────
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
CLOUDPAYMENTS_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# ENCRYPTION (AES-256 for bank tokens)
# ─────────────────────────────────────────────
ENCRYPTION_KEY=

# ─────────────────────────────────────────────
# BANKING (mock endpoints in dev)
# ─────────────────────────────────────────────
KASPI_CLIENT_ID=
KASPI_CLIENT_SECRET=
KASPI_REDIRECT_URI=http://localhost:4000/api/banking/kaspi/callback
HALYK_CLIENT_ID=
HALYK_CLIENT_SECRET=
HALYK_REDIRECT_URI=http://localhost:4000/api/banking/halyk/callback

# ─────────────────────────────────────────────
# eGov / КГД ИСНА Integration
# Obtain from: https://portal.kgd.gov.kz/ru/pages/api-services
# Smart Bridge service keys: FNO_INTEGRATION, FNO_INTEGRATION_STATUS
# NOTE: СОНО is shut down 01 May 2026 — only ИСНА is supported.
# ─────────────────────────────────────────────
EGOV_ISNA_URL=https://knp.kgd.gov.kz/api/fno
EGOV_ISNA_TOKEN=

# ─────────────────────────────────────────────
# FRONTEND (Vite — prefix with VITE_)
# ─────────────────────────────────────────────
VITE_API_URL=http://localhost:4000/api
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

# Optional frontend source-map upload during production builds
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ─────────────────────────────────────────────
# BACKUP
# ─────────────────────────────────────────────
BACKUP_RETAIN_DAYS=30

# ─────────────────────────────────────────────
# VERCEL DEPLOYMENT (set in Vercel Dashboard)
# ─────────────────────────────────────────────
# VERCEL_URL is auto-set by Vercel (e.g. nalogai-abc123.vercel.app)
# CORS_ORIGIN should be your production domain (e.g. https://nalogai.vercel.app)
# CORS_ORIGIN=https://nalogai.vercel.app
